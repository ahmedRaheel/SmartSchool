# Local development example only. Copy to .env and set your own values.
POSTGRES_PASSWORD=replace-local-password
IDENTITY_CLIENT_ID=smartschool-api-service
IDENTITY_CLIENT_SECRET=replace-local-service-secret
IDENTITY_LOGIN_SECRET=replace-local-login-secret
IDENTITY_MANAGEMENT_SCOPE=smartschool.identity.manage
IDENTITY_PUBLIC_ISSUER=http://localhost:7101
IDENTITY_INTERNAL_URL=http://host.docker.internal:7101
SUPERADMIN_PASSWORD=replace-local-bootstrap-password
