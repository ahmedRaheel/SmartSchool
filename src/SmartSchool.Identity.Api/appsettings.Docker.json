{
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool"
  },
  "ConnectionStrings": {
    "SmartSchool": "Host=host.docker.internal;Port=5432;Database=smartschool;Username=postgres;Password=${POSTGRES_PASSWORD}"
  },
  "DuendeIdentityServer": {
    "LicenseKey": "",
    "UseDeveloperSigningCredential": true,
    "IssuerUri": "http://host.docker.internal:7101",
    "PortalUrl": "http://localhost:5173",
    "MobileRedirectUri": "smartschool://oauth/callback"
  },
  "SmartSchoolApiClient": {
    "ClientSecret": "${IDENTITY_CLIENT_SECRET}"
  },
  "BootstrapSuperAdmin": {
    "Enabled": true,
    "Email": "superadmin@smartschool.local",
    "Password": "${SUPERADMIN_PASSWORD}",
    "FirstName": "SmartSchool",
    "LastName": "SuperAdmin"
  },
  "AllowedHosts": "*",
  "LoginApiClient": {
    "ClientId": "smartschool-login-api",
    "ClientSecret": "development-login-api-secret-change-me",
    "TokenEndpoint": "http://127.0.0.1:8080/connect/token"
  },
  "Cors": {
    "PortalOrigins": [
      "http://localhost:5173"
    ]
  },
  "InternalApiAuthentication": {
    "Authority": "http://host.docker.internal:7101",
    "RequiredScope": "smartschool.identity.manage",
    "RequireHttpsMetadata": false
  }
}