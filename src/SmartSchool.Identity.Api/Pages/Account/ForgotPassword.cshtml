@page "/account/forgot-password"
@model SmartSchool.Identity.Api.Pages.Account.ForgotPasswordModel
<!doctype html><html><body><main><h1>Forgot password</h1>
@if(Model.Submitted){<p>If the account exists, reset instructions will be sent.</p>}
else {<form method="post"><label>Email <input asp-for="Email" type="email" required/></label><button type="submit">Continue</button></form>}
</main></body></html>