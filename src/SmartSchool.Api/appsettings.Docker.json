{
  "Database": {
    "ConnectionString": "Host=host.docker.internal;Port=5432;Database=smartschool;Username=postgres;Password=${POSTGRES_PASSWORD}",
    "Provider": "PostgreSql",
    "CommandTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "SmartSchool": "Host=host.docker.internal;Port=5432;Database=smartschool;Username=postgres;Password=${POSTGRES_PASSWORD}",
    "Redis": "host.docker.internal:6379"
  },
  "PortalUrl": "http://localhost:5173",
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "EnableSensitiveDataLogging": false
  },
  "Identity": {
    "Provider": "IdentityServer",
    "Authority": "http://host.docker.internal:7101",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": false,
    "MetadataAddress": "http://host.docker.internal:7101/.well-known/openid-configuration",
    "ValidIssuer": "http://host.docker.internal:7101"
  },
  "IdentityService": {
    "BaseUrl": "http://host.docker.internal:7101",
    "ClientId": "smartschool-api-service",
    "ClientSecret": "${IDENTITY_CLIENT_SECRET}",
    "Scope": "smartschool.identity.manage"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "host.docker.internal:9092",
    "ClientId": "smartschool-api",
    "GroupId": "smartschool"
  },
  "Caching": {
    "Provider": "Redis",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://host.docker.internal:11434",
      "ChatModel": "qwen3:1.7b",
      "EmbeddingModel": "nomic-embed-text",
      "TimeoutSeconds": 180,
      "TopK": 5,
      "RequireCitations": true
    },
    "CAG": {
      "Enabled": true,
      "ContextTtlMinutes": 30,
      "MaxCachedChunks": 20
    }
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/ops/jobs"
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  },
  "LoggingOptions": {
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 30,
    "DatabaseEnabled": true,
    "DatabaseConnectionStringName": "SmartSchool",
    "DatabaseSchema": "observability",
    "DatabaseTable": "application_log",
    "DatabaseMinimumLevel": "Information"
  },
  "ErrorHandling": {
    "InternalServerErrorTypeUri": "https://smartschool/errors/internal-server-error"
  }
}
