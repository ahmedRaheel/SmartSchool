{
  "Kafka": {
    "Enabled": false
  },
  "Identity": {
    "Provider": "Mock",
    "Authority": "https://identity.smartschool.local",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": false
  },
  "Database": {
    "ConnectionString": "InMemory:SmartSchool-Development",
    "CommandTimeoutSeconds": 30
  },
  "Hangfire": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "SmartSchool": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Persistence": {
    "Provider": "Mock",
    "ConnectionStringName": "SmartSchool",
    "EnableSensitiveDataLogging": false
  },
  "Caching": {
    "Provider": "Memory",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartschool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  }
}
