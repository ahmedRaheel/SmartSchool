{
  "Kafka": {
    "Enabled": false
  },

  "Identity": {
    "Provider": "Mock",
    "Authority": "https://identity.smartschool.local",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": false
  },

  "ConnectionStrings": {
    "SmartSchool": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=123456",
    "Redis": "localhost:6379"
  },

  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },

  "Hangfire": {
    "Enabled": false
  },

  "Caching": {
    "Provider": "Memory",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartschool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  },

  "DocumentStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Documents",
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },

  "AI": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "llama3.2",
      "EmbeddingModel": "nomic-embed-text",
      "TopK": 5,
      "RequireCitations": true
    }
  },

  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  }
}