{
  "Kafka": {
    "Enabled": false
  },
  "Identity": {
    "Provider": "IdentityServer",
    "Authority": "http://localhost:7101",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": false,
    "MetadataAddress": "http://localhost:7101/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:7101"
  },
  "ConnectionStrings": {
    "SmartSchool": "Host=host.docker.internal;Port=5432;Database=smartschool;Username=postgres;Password=${POSTGRES_PASSWORD}",
    "Redis": "localhost:6379"
  },
  "PortalUrl": "http://localhost:5173",
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Hangfire": {
    "Enabled": false
  },
  "Caching": {
    "Provider": "Memory",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  },
  "DocumentStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Documents",
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },
  "AI": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "llama3.2",
      "EmbeddingModel": "nomic-embed-text",
      "TopK": 5,
      "RequireCitations": true
    },
    "CAG": {
      "Enabled": true,
      "ContextTtlMinutes": 30,
      "MaxCachedChunks": 20
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  },
  "DuendeIdentityServer": {
    "IssuerUri": "http://localhost:7101",
    "PortalUrl": "https://localhost:5173",
    "MobileRedirectUri": "smartschool://oauth/callback",
    "SeedAdmin": {
      "Email": "admin@smartschool.local",
      "Password": "ChangeMe123!"
    },
    "LicenseKey": "",
    "UseDeveloperSigningCredential": true
  },
  "IdentityService": {
    "BaseUrl": "http://localhost:7101",
    "ClientId": "smartschool-api-service",
    "ClientSecret": "development-only-change-me",
    "Scope": "smartschool.identity.manage"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Trace",
      "Microsoft.IdentityModel": "Debug",
      "SmartSchool.Authentication": "Debug"
    }
  },
  "LoggingOptions": {
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 30,
    "DatabaseEnabled": true,
    "DatabaseConnectionStringName": "SmartSchool",
    "DatabaseSchema": "observability",
    "DatabaseTable": "application_log",
    "DatabaseMinimumLevel": "Information"
  },
  "ErrorHandling": {
    "InternalServerErrorTypeUri": "https://smartschool/errors/internal-server-error"
  }
}
