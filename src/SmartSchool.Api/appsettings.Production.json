{
  "ConnectionStrings": {
    "SmartSchool": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "EnableSensitiveDataLogging": false
  },
  "PortalUrl": "http://localhost:5173",
  "Caching": {
    "Provider": "Redis",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "Identity": {
    "Provider": "IdentityServer",
    "Authority": "https://identity.smartschool.local",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": true,
    "MetadataAddress": "https://identity.smartschool.local/.well-known/openid-configuration",
    "ValidIssuer": "https://identity.smartschool.local"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  },
  "DocumentStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Documents",
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },
  "AI": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "llama3.2",
      "EmbeddingModel": "nomic-embed-text",
      "TimeoutSeconds": 180,
      "TopK": 5,
      "RequireCitations": true
    },
    "CAG": {
      "Enabled": true,
      "ContextTtlMinutes": 30,
      "MaxCachedChunks": 20
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "Cache": {
    "Provider": "PostgreSql",
    "DefaultExpirationMinutes": 30,
    "PostgreSqlSchema": "Infrastructure",
    "PostgreSqlTable": "DistributedCache"
  },
  "LoggingOptions": {
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 30,
    "DatabaseEnabled": true,
    "DatabaseConnectionStringName": "SmartSchool",
    "DatabaseSchema": "observability",
    "DatabaseTable": "application_log",
    "DatabaseMinimumLevel": "Information"
  },
  "ErrorHandling": {
    "InternalServerErrorTypeUri": "https://smartschool/errors/internal-server-error"
  }
}
