{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=CHANGE_ME",
    "CommandTimeoutSeconds": 30,
    "Provider": "PostgreSql"
  },
  "Identity": {
    "Provider": "IdentityServer",
    "Authority": "https://localhost:7101",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": false,
    "MetadataAddress": "https://localhost:7101/.well-known/openid-configuration",
    "ValidIssuer": "https://localhost:7101"
  },
  "PortalUrl": "http://localhost:5173",
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "smartschool-api",
    "GroupId": "smartschool"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/ops/jobs"
  },
  "AI": {
    "Provider": "OpenAI",
    "ChatModel": "gpt-5-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "ApiKey": "",
    "Temperature": 0.2,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "llama3.2",
      "EmbeddingModel": "nomic-embed-text",
      "TopK": 5,
      "RequireCitations": true
    },
    "CAG": {
      "Enabled": true,
      "ContextTtlMinutes": 30,
      "MaxCachedChunks": 20
    }
  },
  "ML": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  },
  "ConnectionStrings": {
    "SmartSchool": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "EnableSensitiveDataLogging": false
  },
  "Caching": {
    "Provider": "Redis",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "DocumentStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Documents",
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  },
  "Cache": {
    "Provider": "PostgreSql",
    "DefaultExpirationMinutes": 30,
    "PostgreSqlSchema": "Infrastructure",
    "PostgreSqlTable": "DistributedCache"
  },
  "DuendeIdentityServer": {
    "IssuerUri": "https://localhost:5001",
    "PortalUrl": "https://localhost:5173",
    "MobileRedirectUri": "smartschool://oauth/callback",
    "SeedAdmin": {
      "Email": "admin@smartschool.local",
      "Password": "ChangeMe123!"
    },
    "LicenseKey": "",
    "UseDeveloperSigningCredential": true
  },
  "IdentityService": {
    "BaseUrl": "https://localhost:7101",
    "ClientId": "smartschool-api-service",
    "ClientSecret": "development-only-change-me",
    "Scope": "smartschool.identity.manage"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "LoggingOptions": {
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 30,
    "DatabaseEnabled": true,
    "DatabaseConnectionStringName": "SmartSchool",
    "DatabaseSchema": "observability",
    "DatabaseTable": "application_log",
    "DatabaseMinimumLevel": "Information"
  },
  "ErrorHandling": {
    "InternalServerErrorTypeUri": "https://smartschool/errors/internal-server-error"
  }
}
