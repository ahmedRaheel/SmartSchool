{
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "Provider": "PostgreSql"
  },
  "Identity": {
    "Provider": "IdentityServer",
    "Authority": "",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": true,
    "MetadataAddress": "",
    "ValidIssuer": ""
  },
  "PortalUrl": "",
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "",
    "ClientId": "smartschool-api",
    "GroupId": "smartschool"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/ops/jobs"
  },
  "AI": {
    "Provider": "Ollama",
    "ChatModel": "llama3.2:1b",
    "EmbeddingModel": "all-minilm",
    "ApiKey": "",
    "Temperature": 0.2,
    "Ollama": {
      "BaseUrl": "",
      "ChatModel": "llama3.2:1b",
      "EmbeddingModel": "all-minilm",
      "TopK": 5,
      "RequireCitations": true
    },
    "CAG": {
      "Enabled": true,
      "ContextTtlMinutes": 30,
      "MaxCachedChunks": 20
    }
  },
  "ML": {
    "BaseUrl": "",
    "TimeoutSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SmartSchool.Api"
    }
  },
  "ConnectionStrings": {
    "SmartSchool": "",
    "Redis": ""
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "SmartSchool",
    "EnableSensitiveDataLogging": false
  },
  "Caching": {
    "Provider": "Redis",
    "RedisConnectionStringName": "Redis",
    "InstanceName": "SmartSchool:",
    "DefaultExpirationMinutes": 10
  },
  "DocumentStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/Documents",
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": false,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4
  },
  "Cache": {
    "Provider": "PostgreSql",
    "DefaultExpirationMinutes": 30,
    "PostgreSqlSchema": "Infrastructure",
    "PostgreSqlTable": "DistributedCache"
  },
  "DuendeIdentityServer": {
    "IssuerUri": "",
    "PortalUrl": "",
    "MobileRedirectUri": "smartschool://oauth/callback",
    "SeedAdmin": {
      "Email": "",
      "Password": ""
    },
    "LicenseKey": "",
    "UseDeveloperSigningCredential": false
  },
  "IdentityService": {
    "BaseUrl": "",
    "ClientId": "smartschool-api-service",
    "ClientSecret": "",
    "Scope": "smartschool.identity.manage"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "LoggingOptions": {
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 30,
    "DatabaseEnabled": true,
    "DatabaseConnectionStringName": "SmartSchool",
    "DatabaseSchema": "observability",
    "DatabaseTable": "application_log",
    "DatabaseMinimumLevel": "Information"
  },
  "ErrorHandling": {
    "InternalServerErrorTypeUri": "https://smartschool/errors/internal-server-error"
  }
}
