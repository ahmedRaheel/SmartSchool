{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=smartschool;Username=postgres;Password=CHANGE_ME",
    "CommandTimeoutSeconds": 30
  },
  "Identity": {
    "Authority": "https://identity.smartschool.local",
    "Audience": "smartschool-api",
    "RequireHttpsMetadata": true
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "smartschool-api",
    "GroupId": "smartschool"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/ops/jobs"
  },
  "AI": {
    "Provider": "OpenAI",
    "ChatModel": "gpt-5-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "ApiKey": "",
    "Temperature": 0.2
  },
  "ML": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithSpan"
    ]
  }
}