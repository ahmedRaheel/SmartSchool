<Project>

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('SmartSchool.Modules.'))">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.SharedKernel/SmartSchool.SharedKernel.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.Application/SmartSchool.Application.csproj" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SmartSchool.Application'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.SharedKernel/SmartSchool.SharedKernel.csproj" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SmartSchool.Infrastructure'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.SharedKernel/SmartSchool.SharedKernel.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.Application/SmartSchool.Application.csproj" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SmartSchool.Api'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/SmartSchool.Infrastructure/SmartSchool.Infrastructure.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Modules/*/SmartSchool.Modules.*.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
